#!/usr/bin/env bash

if [ -n "${BASH_VERSION:-}" ]; then
  # Prevent accidentally closing the shell with Ctrl-D.
  set -o ignoreeof
  # Report background job status changes immediately.
  set -o notify
  # Keep the default file creation mask predictable.
  umask 022
  # Avoid storing duplicated consecutive commands in shell history.
  export HISTCONTROL=ignoredups

  # Add color to man/less output in terminals that honor LESS_TERMCAP.
  export LESS_TERMCAP_mb=$'\E[01;31m'
  export LESS_TERMCAP_md=$'\E[01;31m'
  export LESS_TERMCAP_me=$'\E[0m'
  export LESS_TERMCAP_se=$'\E[0m'
  export LESS_TERMCAP_so=$'\E[01;44;33m'
  export LESS_TERMCAP_ue=$'\E[0m'
  export LESS_TERMCAP_us=$'\E[01;32m'
fi
