#!/usr/bin/env bash

# Put activity review tools on PATH.

if [ -n "${BASH_VERSION:-}" ]; then
  activity_tools_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  activity_tools_bin="$(cd "$activity_tools_dir/../bin" && pwd)"
  case ":$PATH:" in
    *":$activity_tools_bin:"*) ;;
    *) export PATH="$activity_tools_bin:$PATH" ;;
  esac
  unset activity_tools_bin activity_tools_dir
fi
